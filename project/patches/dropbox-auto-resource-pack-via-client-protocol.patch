diff --git a/src/main/java/com/dropboxautoresourcepack/ClientProtocolSelector.java b/src/main/java/com/dropboxautoresourcepack/ClientProtocolSelector.java
new file mode 100644
index 0000000..706bdd1
--- /dev/null
+++ b/src/main/java/com/dropboxautoresourcepack/ClientProtocolSelector.java
@@ -0,0 +1,22 @@
+package com.dropboxautoresourcepack;
+
+final class ClientProtocolSelector {
+    private ClientProtocolSelector() {
+    }
+
+    static Selection select(int paperProtocol, boolean viaEnabled, Integer viaProtocol) {
+        if (!viaEnabled) {
+            return new Selection(paperProtocol, "Paper");
+        }
+        if (viaProtocol == null || viaProtocol < 0) {
+            return new Selection(null, "ViaVersion-unavailable");
+        }
+        return new Selection(viaProtocol, "ViaVersion");
+    }
+
+    record Selection(Integer protocol, String source) {
+        boolean resolved() {
+            return protocol != null;
+        }
+    }
+}
diff --git a/src/main/java/com/dropboxautoresourcepack/ViaProtocolLookup.java b/src/main/java/com/dropboxautoresourcepack/ViaProtocolLookup.java
new file mode 100644
index 0000000..8e75efd
--- /dev/null
+++ b/src/main/java/com/dropboxautoresourcepack/ViaProtocolLookup.java
@@ -0,0 +1,21 @@
+package com.dropboxautoresourcepack;
+
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.protocol.version.ProtocolVersion;
+import java.util.UUID;
+
+final class ViaProtocolLookup {
+    private ViaProtocolLookup() {
+    }
+
+    static Integer getPlayerProtocol(UUID playerId) {
+        if (!Via.isLoaded()) {
+            return null;
+        }
+        ProtocolVersion version = Via.getAPI().getPlayerProtocolVersion(playerId);
+        if (version == null || !version.isKnown()) {
+            return null;
+        }
+        return version.getVersion();
+    }
+}
