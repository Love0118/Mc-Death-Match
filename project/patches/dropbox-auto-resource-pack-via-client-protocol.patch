diff --git a/src/test/java/com/dropboxautoresourcepack/ClientProtocolSelectorTest.java b/src/test/java/com/dropboxautoresourcepack/ClientProtocolSelectorTest.java
new file mode 100644
index 0000000..831da7e
--- /dev/null
+++ b/src/test/java/com/dropboxautoresourcepack/ClientProtocolSelectorTest.java
@@ -0,0 +1,35 @@
+package com.dropboxautoresourcepack;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+class ClientProtocolSelectorTest {
+    @Test
+    void viaOriginalProtocolWinsOverTranslatedPaperProtocol() {
+        ClientProtocolSelector.Selection selection = ClientProtocolSelector.select(776, true, 772);
+
+        assertTrue(selection.resolved());
+        assertEquals(772, selection.protocol());
+        assertEquals("ViaVersion", selection.source());
+    }
+
+    @Test
+    void directConnectionUsesPaperProtocolWhenViaIsDisabled() {
+        ClientProtocolSelector.Selection selection = ClientProtocolSelector.select(776, false, null);
+
+        assertTrue(selection.resolved());
+        assertEquals(776, selection.protocol());
+        assertEquals("Paper", selection.source());
+    }
+
+    @Test
+    void missingViaProtocolFailsClosedInsteadOfSendingTranslatedPack() {
+        ClientProtocolSelector.Selection selection = ClientProtocolSelector.select(776, true, null);
+
+        assertFalse(selection.resolved());
+        assertEquals("ViaVersion-unavailable", selection.source());
+    }
+}
